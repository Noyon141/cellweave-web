# CellWeave Web Environment Configuration Template
# Research Use Only (RUO). Do NOT commit real secrets or production credentials.

NODE_ENV=development
PORT=3000

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-placeholder.us-east-1.aws.neon.tech/cellweave_dev?sslmode=require
# DATABASE_URL must authenticate as cellweave_app_runtime.
# Internal finalization only: separate cellweave_import_finalizer credential.
# Missing/blank configuration disables finalization with an explicit error; no fallback.
IMPORT_FINALIZER_DATABASE_URL=

# Authentication (BetterAuth & Google OAuth — Phase 1 Identity)
# Required in real DEV/STAGING runtimes. High-entropy secret (min 32 chars).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Audit Privacy (Keyed HMAC salt for IP pseudonymization)
AUDIT_IP_HASH_SECRET=cellweave_audit_ip_hash_salt_dev_local_secret

# Scientific Storage (Cloudflare R2)
R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key_id
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_access_key
R2_BUCKET_NAME=cellweave-datasets-dev
R2_PUBLIC_DOMAIN=

# Commercial Billing (Polar)
POLAR_ACCESS_TOKEN=polar_at_placeholder
POLAR_WEBHOOK_SECRET=polar_wh_placeholder
POLAR_ORGANIZATION_ID=placeholder_org_id

# Durable Orchestration (Temporal Cloud)
TEMPORAL_ADDRESS=cellweave.tmprl.cloud:7233
TEMPORAL_NAMESPACE=cellweave-dev.default
# Optional API Key Authentication (for Temporal Cloud in development/staging/production)
TEMPORAL_API_KEY=
TEMPORAL_CLIENT_CERT=
TEMPORAL_CLIENT_KEY=

# Email (Resend)
RESEND_API_KEY=re_placeholder

# Observability (Sentry)
SENTRY_DSN=

# Phase 4 internal service authentication; inject distinct keys per environment.
SERVICE_AUTH_ENVIRONMENT=local
SERVICE_AUTH_ALGORITHM=ES256
SERVICE_AUTH_TRUST_BUNDLE=

CELLWEAVE_ENVIRONMENT=local
TEMPORAL_TASK_QUEUE=cellweave-analysis-queue
# Approved immutable execution pipeline identifier and operator-defined safety ceilings.
EXECUTION_PIPELINE_VERSION=
EXECUTION_CEILINGS_JSON=

# Phase 5 operator-approved QC pipeline and CPU safety ceilings (no biological cutoffs).
QC_PIPELINE_VERSION=
QC_ANALYSIS_CEILINGS_JSON=
QC_FILTER_CEILINGS_JSON=
