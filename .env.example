# CellWeave Web Environment Configuration Template
# Research Use Only (RUO). Do NOT commit real secrets or production credentials.

NODE_ENV=development
PORT=3000

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-placeholder.us-east-1.aws.neon.tech/cellweave_dev?sslmode=require

# Authentication (BetterAuth)
BETTER_AUTH_SECRET=placeholder_secret_32_characters_minimum_length_required
BETTER_AUTH_URL=http://localhost:3000

# Scientific Storage (Cloudflare R2)
R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key_id
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_access_key
R2_BUCKET_NAME=cellweave-datasets-dev
R2_PUBLIC_DOMAIN=

# Commercial Billing (Polar)
POLAR_ACCESS_TOKEN=polar_at_placeholder
POLAR_WEBHOOK_SECRET=polar_wh_placeholder
POLAR_ORGANIZATION_ID=placeholder_org_id

# Durable Orchestration (Temporal Cloud)
TEMPORAL_ADDRESS=cellweave.tmprl.cloud:7233
TEMPORAL_NAMESPACE=cellweave-dev.default
# Optional API Key Authentication (for Temporal Cloud in development/staging/production)
TEMPORAL_API_KEY=
TEMPORAL_CLIENT_CERT=
TEMPORAL_CLIENT_KEY=

# Email (Resend)
RESEND_API_KEY=re_placeholder

# Observability (Sentry)
SENTRY_DSN=
